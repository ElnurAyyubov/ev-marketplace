# Copy to .env (gitignored) and fill in real values. Never commit .env.

# Used by the natural-language search endpoint (POST /search/nl). Both have
# sensible defaults for a local Ollama install and can be omitted; set them
# only to point at a non-default host or model. See gateway/README.md
# "Natural-language search" for details.
OLLAMA_URL=http://localhost:11434
OLLAMA_MODEL=qwen2.5:3b-instruct

# Used by the trip planner (POST /trip/plan, POST /trip/plan/nl). All have
# working defaults; set them only to point at a self-hosted geocoder/router
# or to disable the (cosmetic, optional) road overlay. See gateway/README.md
# "Trip planner" for details.
NOMINATIM_URL=https://nominatim.openstreetmap.org
NOMINATIM_MIN_INTERVAL_MS=1000
NOMINATIM_USER_AGENT=ev-charging-marketplace-trip-planner/1.0
OSRM_URL=https://router.project-osrm.org
TRIP_ROAD_OVERLAY=true

# Used by the voice search endpoint (POST /search/voice). All have working
# defaults. See gateway/README.md "Voice search" for the whisper.cpp setup
# this depends on and the privacy note on why the endpoint never receives
# the driver's coordinates. VOICE_ENABLED=false unmounts the route entirely
# (POST /search/voice then 404s) and the frontend hides the mic button.
WHISPER_URL=http://localhost:8080
VOICE_NEARBY_RADIUS_KM=25
VOICE_MAX_SECONDS=15
VOICE_ENABLED=true

# Used by gateway/src/provisioning.ts (the container self-provisioning
# flow, see CONTAINER_PROVISIONING_ADDENDUM.md) to register+enroll a new
# identity against the Fabric CA. Defaults match a local test-network CA;
# override for a real deployment. CA_TLS_CERT_PATH has no baked-in default
# inside the container image on purpose -- the test-network's cert is
# dev-only, a real network's cert belongs to that deployment.
CA_NAME=ca-org1
CA_ENDPOINT=localhost:7054
CA_TLS_CERT_PATH=../fabric-samples/test-network/organizations/fabric-ca/org1/ca-cert.pem